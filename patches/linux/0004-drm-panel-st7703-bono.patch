+static void bono_init_sequence(struct mipi_dsi_multi_context *dsi_ctx)
+{
+	/*
+	 * Init sequence for the WHY2025 badge v2.1 "BONO" 720x720 panel.
+	 * Transcribed from the ESP-IDF bring-up
+	 * (linux-native-scratch/main/main.c, USE_BONO=1 branch).
+	 *
+	 * st7703_enable() handles exit_sleep + display_on after this
+	 * returns, so no 0x11/0x29 here.
+	 *
+	 * IMPORTANT: send COLMOD (DCS 0x3A) BEFORE the vendor sequence so
+	 * the panel's pixel-format decoder matches the host's DPI_COLOR_
+	 * CODING. ST7703 default COLMOD after reset is RGB888, but we send
+	 * RGB565 long packets — without this, every video packet is
+	 * rejected as malformed and the panel renders black even though
+	 * its display_on bit is set. IDF does this in
+	 * esp_lcd_st7703.c:st7703_init_panel() before vendor_specific_
+	 * init_default[]. Value 0x55 = RGB565 (per IDF colmod_val mapping
+	 * at esp_lcd_st7703.c line 84).
+	 */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_SET_PIXEL_FORMAT, 0x55);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETEXTC,
+				     0xF1, 0x12, 0x83);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETAPID,
+				     0x00, 0x00, 0x00, 0xDA, 0x80);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETDISP,
+				     0x3C, 0x02, 0x30);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETRGBIF,
+				     0x10, 0x10, 0x28, 0x28, 0x03, 0xFF,
+				     0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETCYC, 0x80);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETBGP, 0x0A, 0x0A);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETVCOM, 0x97, 0x97);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETPOWER_EXT,
+				     0x26, 0x22, 0xF0, 0x63);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETMIPI,
+				     0x31, 0x81, 0x05, 0xF9, 0x0E, 0x0E,
+				     0x20, 0x00, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x44, 0x25, 0x00, 0x90,
+				     0x0A, 0x00, 0x00, 0x01, 0x4F, 0x01,
+				     0x00, 0x00, 0x37);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETVDC, 0x47);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_UNKNOWN_BF,
+				     0x02, 0x11, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETSCR,
+				     0x73, 0x73, 0x50, 0x50, 0x00, 0x00,
+				     0x12, 0x70, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETPOWER,
+				     0x43, 0x00, 0x32, 0x32, 0x77, 0xC1,
+				     0xFF, 0xFF, 0xCC, 0xCC, 0x77, 0x77);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETECO,
+				     0x82, 0x00, 0xBF, 0xFF, 0x00, 0xFF);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETIO,
+				     0xB8, 0x00, 0x0A, 0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETCABC,
+				     0x10, 0x40, 0x1E, 0x02);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETPANEL, 0x0B);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETGAMMA,
+				     0x00, 0x0B, 0x10, 0x2C, 0x3D, 0x3F,
+				     0x42, 0x3A, 0x07, 0x0D, 0x0F, 0x13,
+				     0x15, 0x13, 0x14, 0x0F, 0x16, 0x00,
+				     0x0B, 0x10, 0x2C, 0x3D, 0x3F, 0x42,
+				     0x3A, 0x07, 0x0D, 0x0F, 0x13, 0x15,
+				     0x13, 0x14, 0x0F, 0x16);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETEQ,
+				     0x07, 0x07, 0x0B, 0x0B, 0x0B, 0x0B,
+				     0x00, 0x00, 0x00, 0x00, 0xFF, 0x00,
+				     0xC0, 0x10);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETGIP1,
+				     0xC8, 0x10, 0x0A, 0x00, 0x00, 0x80,
+				     0x81, 0x12, 0x31, 0x23, 0x4F, 0x86,
+				     0xA0, 0x00, 0x47, 0x08, 0x00, 0x00,
+				     0x0C, 0x00, 0x00, 0x00, 0x00, 0x00,
+				     0x0C, 0x00, 0x00, 0x00, 0x98, 0x02,
+				     0x8B, 0xAF, 0x46, 0x02, 0x88, 0x88,
+				     0x88, 0x88, 0x88, 0x98, 0x13, 0x8B,
+				     0xAF, 0x57, 0x13, 0x88, 0x88, 0x88,
+				     0x88, 0x88, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETGIP2,
+				     0x97, 0x0C, 0x09, 0x09, 0x09, 0x78,
+				     0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+				     0x9F, 0x31, 0x8B, 0xA8, 0x31, 0x75,
+				     0x88, 0x88, 0x88, 0x88, 0x88, 0x9F,
+				     0x20, 0x8B, 0xA8, 0x20, 0x64, 0x88,
+				     0x88, 0x88, 0x88, 0x88, 0x23, 0x00,
+				     0x00, 0x02, 0x62, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x40, 0x80, 0x81, 0x00,
+				     0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_UNKNOWN_EF,
+				     0xFF, 0xFF, 0x01);
+}
+
+static const struct drm_display_mode bono_mode = {
+	.hdisplay    = 720,
+	.hsync_start = 720 + 106,
+	.hsync_end   = 720 + 106 + 60,
+	.htotal	     = 720 + 106 + 60 + 120,
+	.vdisplay    = 720,
+	.vsync_start = 720 + 20,
+	.vsync_end   = 720 + 20 + 4,
+	.vtotal	     = 720 + 20 + 4 + 20,
+	.clock	     = 47000,
+	/* IDF sets all DPI sync polarities active HIGH via
+	 * mipi_dsi_host_ll_dpi_set_timing_polarity(host, false, false, ...).
+	 * NHSYNC|NVSYNC would invert hsync/vsync at the host (DPI_CFG_POL=6),
+	 * which doesn't match what the bridge generates → host VID state
+	 * machine never sees a valid frame and stays in LP-Stop. */
+	.flags	     = DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC,
+	.width_mm    = 72,
+	.height_mm   = 72,
+};
+
+static const struct st7703_panel_desc bono_desc = {
+	.mode = &bono_mode,
+	.lanes = 2,
+	/*
+	 * MIPI_DSI_MODE_LPM: send all DCS commands in LP escape mode.
+	 * ESP32-P4 does not support HS DCS in command mode — IDF confirms
+	 * this by setting all 12 packet types to MIPI_DSI_LL_TRANS_SPEED_LP
+	 * in esp_lcd_panel_io_dbi.c. This flag causes mipi_dsi_device_transfer()
+	 * to add MIPI_DSI_MSG_USE_LPM to every message, which causes
+	 * dw_mipi_message_config() to write CMD_MODE_ALL_LP before each
+	 * transfer. Keep it set for all DCS, including video-mode entry.
+	 */
+	/*
+	 * Mode flags for BONO chosen to match the IDF golden register dump:
+	 *   IDF VID_MODE_CFG = 0xff02   bits[1:0]=2 = VID_MODE_TYPE_BURST
+	 *   IDF LPCLK_CTRL  = 0x3      TXREQUESTCLKHS + AUTO_CLKLANE_CTRL
+	 * The DW core derives those from MIPI_DSI_MODE_VIDEO_BURST and
+	 * MIPI_DSI_CLOCK_NON_CONTINUOUS respectively. Earlier value used
+	 * MIPI_DSI_MODE_VIDEO_SYNC_PULSE which packed video into the wrong
+	 * DSI packet format and would not produce visible output even with
+	 * HS lanes active.
+	 *
+	 * MIPI_DSI_MODE_LPM stays — sends all DCS commands in LP escape
+	 * mode (ESP32-P4 doesn't support HS DCS).
+	 */
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		      MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS,
+	.format = MIPI_DSI_FMT_RGB565,
+	.init_sequence = bono_init_sequence,
+};
